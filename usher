  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #B8934A;
    --gold-light: #F5ECD7;
    --gold-dark: #8A6A2E;
    --charcoal: #1C1C1E;
    --slate: #3A3A3C;
    --muted: #6C6C70;
    --light: #F8F7F4;
    --white: #FFFFFF;
    --border: #E5E0D5;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--light);
    color: var(--charcoal);
    line-height: 1.7;
    font-size: 16px;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    background: rgba(248,247,244,0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    padding: 0 2rem;
    height: 60px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--charcoal);
    letter-spacing: 0.02em;
  }
  .nav-links { display: flex; gap: 1.8rem; list-style: none; }
  .nav-links a {
    text-decoration: none; font-size: 0.82rem; font-weight: 500;
    color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--gold); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    background: var(--charcoal);
    padding: 6rem 2rem 4rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #1C1C1E 55%, #2C2417 100%);
  }
  .hero-accent {
    position: absolute; top: 0; right: 0;
    width: 40%; height: 100%;
    background: linear-gradient(180deg, rgba(184,147,74,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 4rem;
    max-width: 900px; width: 100%;
  }
  .avatar-wrap {
    flex-shrink: 0;
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 3px solid var(--gold);
    background: linear-gradient(145deg, #B8934A22, #B8934A44);
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .avatar-initials {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem; font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.05em;
  }
  .avatar-wrap img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: top center;
    border-radius: 50%;
  }
  .avatar-ring {
    position: absolute; inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(184,147,74,0.3);
  }
  .hero-text { flex: 1; }
  .hero-badge {
    display: inline-block;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--gold);
    border: 1px solid rgba(184,147,74,0.4);
    padding: 4px 14px; border-radius: 20px; margin-bottom: 1.2rem;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 600; color: #FFFFFF;
    line-height: 1.15; margin-bottom: 0.5rem;
  }
  .hero-title {
    font-size: 1rem; font-weight: 400;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1.5rem; letter-spacing: 0.03em;
  }
  .hero-contact {
    display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;
  }
  .contact-pill {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.82rem; color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 6px 14px; border-radius: 20px;
    text-decoration: none; transition: all 0.2s;
  }
  .contact-pill:hover { background: rgba(184,147,74,0.12); border-color: rgba(184,147,74,0.4); color: var(--gold); }
  .contact-pill svg { width: 14px; height: 14px; }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--gold); color: #1C1C1E;
    font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em;
    padding: 12px 28px; border-radius: 30px; text-decoration: none;
    transition: all 0.2s;
  }
  .hero-cta:hover { background: #CBA35A; transform: translateY(-1px); }

  /* ── SECTIONS ── */
  section { padding: 5rem 2rem; }
  .container { max-width: 860px; margin: 0 auto; }
  .section-label {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 0.6rem;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600; color: var(--charcoal);
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* ── ABOUT ── */
  #about { background: var(--white); }
  .about-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .about-stats { display: flex; flex-direction: column; gap: 1rem; }
  .stat-card {
    background: var(--light);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2rem 1.4rem;
    text-align: center;
  }
  .stat-card .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem; color: var(--gold); font-weight: 600; display: block;
  }
  .stat-card .stat-label {
    font-size: 0.78rem; color: var(--muted); text-transform: uppercase;
    letter-spacing: 0.08em; margin-top: 2px;
  }
  .about-bio p {
    color: var(--slate); font-size: 1rem; line-height: 1.85;
    margin-bottom: 1.2rem;
  }

  /* ── SKILLS ── */
  #skills { background: var(--light); }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; }
  .skill-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.4rem 1.6rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .skill-card:hover { border-color: var(--gold); transform: translateY(-2px); }
  .skill-icon {
    width: 42px; height: 42px;
    background: var(--gold-light);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1rem;
    color: var(--gold-dark);
    font-size: 1.3rem;
  }
  .skill-name {
    font-weight: 600; font-size: 0.95rem;
    color: var(--charcoal); margin-bottom: 0.3rem;
  }
  .skill-desc { font-size: 0.84rem; color: var(--muted); line-height: 1.6; }

  /* ── EXPERIENCE ── */
  #experience { background: var(--white); }
  .experience-note {
    background: var(--gold-light);
    border: 1px solid rgba(184,147,74,0.3);
    border-left: 4px solid var(--gold);
    border-radius: 0 12px 12px 0;
    padding: 1.2rem 1.6rem;
    margin-bottom: 2rem;
  }
  .experience-note p { font-size: 0.9rem; color: var(--gold-dark); }
  .ready-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .ready-item {
    display: flex; align-items: flex-start; gap: 10px;
    background: var(--light); border: 1px solid var(--border);
    border-radius: 10px; padding: 1rem 1.2rem;
    font-size: 0.88rem; color: var(--slate);
  }
  .ready-check {
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--gold); color: #fff;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 1px; font-size: 0.7rem; font-weight: 700;
  }

  /* ── QUALITIES ── */
  #qualities { background: var(--charcoal); }
  #qualities .section-title { color: #fff; border-color: rgba(255,255,255,0.1); }
  #qualities .section-label { color: var(--gold); }
  .qualities-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.2rem; }
  .quality-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; padding: 1.6rem 1.4rem; text-align: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .quality-card:hover { background: rgba(184,147,74,0.08); border-color: rgba(184,147,74,0.3); }
  .quality-icon { font-size: 2rem; margin-bottom: 0.8rem; }
  .quality-name { font-size: 0.9rem; font-weight: 600; color: #fff; margin-bottom: 0.3rem; }
  .quality-sub { font-size: 0.8rem; color: rgba(255,255,255,0.45); }

  /* ── TRAINING ── */
  #training { background: var(--light); }
  .training-list { display: flex; flex-direction: column; gap: 1rem; }
  .training-item {
    display: flex; align-items: center; gap: 1.2rem;
    background: var(--white); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.2rem 1.4rem;
    transition: border-color 0.2s;
  }
  .training-item:hover { border-color: var(--gold); }
  .training-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--gold); flex-shrink: 0;
  }
  .training-content { flex: 1; }
  .training-name { font-weight: 600; font-size: 0.95rem; color: var(--charcoal); }
  .training-note { font-size: 0.82rem; color: var(--muted); margin-top: 2px; }
  .training-badge {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em;
    padding: 3px 10px; border-radius: 10px;
    background: var(--gold-light); color: var(--gold-dark);
  }

  /* ── REFERENCES ── */
  #references { background: var(--white); }
  .ref-placeholder {
    background: var(--light); border: 1.5px dashed var(--border);
    border-radius: 14px; padding: 2.5rem; text-align: center;
    color: var(--muted);
  }
  .ref-placeholder .ref-icon { font-size: 2.5rem; margin-bottom: 0.8rem; opacity: 0.4; }
  .ref-placeholder p { font-size: 0.9rem; line-height: 1.7; }

  /* ── CONTACT ── */
  #contact { background: var(--charcoal); }
  #contact .section-title { color: #fff; border-color: rgba(255,255,255,0.1); }
  #contact .section-label { color: var(--gold); }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; }
  .contact-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; padding: 1.4rem;
    display: flex; align-items: center; gap: 1rem;
    text-decoration: none; transition: all 0.2s;
  }
  .contact-card:hover { background: rgba(184,147,74,0.1); border-color: rgba(184,147,74,0.4); }
  .contact-icon {
    width: 44px; height: 44px; border-radius: 10px;
    background: rgba(184,147,74,0.15);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
  }
  .contact-label { font-size: 0.75rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.08em; }
  .contact-value { font-size: 0.9rem; color: #fff; font-weight: 500; margin-top: 2px; }

  /* ── FOOTER ── */
  footer {
    background: #111; padding: 1.5rem 2rem;
    text-align: center; font-size: 0.8rem;
    color: rgba(255,255,255,0.3);
  }
  footer span { color: var(--gold); }

  /* ── RESPONSIVE ── */
  @media (max-width: 680px) {
    .hero-content { flex-direction: column; text-align: center; gap: 2rem; }
    .hero-contact { justify-content: center; }
    .about-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
  }
</style>
</head>
